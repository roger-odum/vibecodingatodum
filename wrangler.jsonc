{
  "$schema": "node_modules/wrangler/config-schema.json",

  // 1. Hernoem dit naar je project. Kleine letters en koppeltekens.
  "name": "lab-mijn-project",

  // Odum Labs. Niet wijzigen — dit is het account waar PoC's thuishoren.
  "account_id": "a453e0f692786a7c194861d306516b4a",

  "main": "src/index.ts",
  "compatibility_date": "2026-09-22",

  // Geen workers.dev-adres erbij. Eén project, één URL, geen tweede
  // link die rondzwerft en die niemand beheert.
  "workers_dev": false,

  // 2. Zet hier dezelfde naam als hierboven. Cloudflare maakt het
  //    DNS-record vanzelf aan bij de eerste deploy.
  "routes": [
    { "pattern": "mijn-project.lab.odum.cloud", "custom_domain": true }
  ],

  "observability": { "enabled": true },

  // Odoo-verbinding. Dit zijn géén geheimen. De API-key (ODOO_API_KEY) en
  // het toegangstoken voor /mcp (MCP_TOKEN) zijn dat wel: die komen als
  // GitHub-secret binnen, zie de README.
  "vars": {
    "ODOO_URL": "",       // bv. https://jouwbedrijf.odoo.com
    "ODOO_DB": "",        // databasenaam, bij Odoo Online meestal 'jouwbedrijf'
    "ODOO_USERNAME": ""   // login van de API-gebruiker
  }

  // Bindings komen hier zodra je ze nodig hebt:
  // "d1_databases": [{ "binding": "DB", "database_name": "...", "database_id": "..." }],
  // "kv_namespaces": [{ "binding": "KV", "id": "..." }],
  // "r2_buckets":    [{ "binding": "BUCKET", "bucket_name": "..." }]
}
